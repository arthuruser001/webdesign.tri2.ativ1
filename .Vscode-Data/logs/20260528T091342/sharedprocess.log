nguageservice/blob/master/docs/customData.md).\r\n\r\nO VS Code carrega dados personalizados na inicialização para aprimorar seu suporte CSS para propriedades personalizadas CSS (variáveis), em regras, pseudoclasses e pseudoelementos especificados nos arquivos JSON.\r\n\r\nOs caminhos do arquivo são relativos ao workspace e somente as configurações da pasta do espaço de trabalho são consideradas.","default":[],"items":{"type":"string"},"scope":"resource"},"css.completion.triggerPropertyValueCompletion":{"type":"boolean","scope":"resource","default":true,"description":"Por padrão, o VS Code dispara a conclusão do valor da propriedade após a seleção de uma propriedade CSS. Use esta configuração para desabilitar esse comportamento."},"css.completion.completePropertyWithSemicolon":{"type":"boolean","scope":"resource","default":true,"description":"Inserir ponto e vírgula no fim da linha ao preencher as propriedades de CSS."},"css.validate":{"type":"boolean","scope":"resource","default":true,"description":"Habilita ou desabilita todas as validações."},"css.hover.documentation":{"type":"boolean","scope":"resource","default":true,"description":"Mostrar a documentação de propriedade e valor em focos do CSS."},"css.hover.references":{"type":"boolean","scope":"resource","default":true,"description":"Mostrar as referências ao MDN durante a focalização do CSS."},"css.lint.compatibleVendorPrefixes":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Ao usar um prefixo específico de fornecedor, inclua também todas as outras propriedades específicas do fornecedor."},"css.lint.vendorPrefix":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","description":"Ao usar um prefixo específico do fornecedor, inclua também a propriedade padrão."},"css.lint.duplicateProperties":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Não use definições