ceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Um conjunto de mapeamentos para regravar os locais dos arquivos de origem indicados pelo sourcemap nos respectivos locais no disco.","type":"object"},"sourceMapRenames":{"default":true,"description":"Se usar o mapeamento de \"nomes\" nos sourcemaps. Isso requer a solicitação de conteúdo de origem, o que pode ser lento com determinados depuradores.","type":"boolean"},"sourceMaps":{"default":true,"description":"Usar os source maps JavaScript (caso haja algum).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Parar o programa automaticamente após a inicialização.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Repetir a conexão com o Node.js após esse número de milissegundos. O padrão é 10000 ms.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Tempos limite para várias operações de depurador.","markdownDescription":"Tempos limite para várias operações de depurador.","properties":{"hoverEvaluation":{"default":500,"description":"Tempo até que a avaliação de valor para símbolos focalizados seja anulada. Se definido como 0, a avaliação de foco nunca expira.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Tempo extra em milissegundos permitido por sessão a ser gasto esperando que os sourcemaps sejam processados, após o tempo mínimo (sourceMapMinPause) ter sido esgotado","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Tempo mínimo em milissegundos gasto aguardando o processamento de cada sourcemap quando um script está sendo analisado","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Configura qual saída de diagnóstico é produzida.","oneOf":[{"description":"Trace may be set to 'true' to write diagnostic logs to the disk.","type":"boolean"},{"add