his.customDescription ? this.customDescription() : def } // Use o método customDescription, se disponível, se não retornar defaultValue\r\n","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Personalize as propriedades mostradas para um objeto no depurador (variáveis locais, etc...). Exemplos:\r\n    1. { ...this, extraProperty: '12345' } // Adicionar uma extraProperty 12345 a todos os objetos\r\n    2. this.customProperties ? this.customProperties() : this // Usar o método customProperties, se disponível, caso contrário, usar as propriedades em this (as propriedades padrão)\r\n    3. function () { return this.customProperties ? this.customProperties() : this } // Usar o método customDescription, se disponível, caso contrário, retornar as propriedades padrão\r\n\r\n    Preterido: esta é uma implementação temporária deste recurso até que haja tempo para implementá-lo da maneira descrita aqui: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Caminho absoluto para o diretório de trabalho do programa que está sendo depurado. Se você definir localRoot, cwd corresponderá ao valor, caso contrário, retornará para workspaceFolder","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Ativa/desativa se deve ser feita uma verificação se os conteúdos dos arquivos no disco correspondem aos carregados no runtime. Isso é útil em uma variedade de cenários e exigido em alguns, mas poderá causar problemas se você tiver transformação de scripts do lado do servidor, por exemplo.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Alterna se o depurador tentará ler símbolos de depuração DWARF do WebAssembly, o que pode consumir muitos recursos. Requer a extensão 'ms-vscode.wasm-dwarf-debugging' para funcionar.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Variáveis de ambiente passadas para o programa. O valor `null` remove a variável do ambiente.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Caminho absoluto para um arquivo que contém as definições de variável de ambiente.","type":"string"},"localRoot":{"default":null,"description":"Caminho para o diretório local que contém o programa.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Permite que você especifique explicitamente a versão do Nó que está em execução, que pode ser usada para desabilitar ou habilitar determinados comportamentos em casos que a detecção de versão automática não funciona.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Quando os source maps estão habilitados, esses padrões glob especificam os arquivos JavaScript gerados. Quando um padrão começa com '!', os arquivos são excluídos. Quando não especificado, o código gerado é esperado no mesmo diretório que sua origem.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"De onde capturar as mensagens de saída: a API de depuração padrão, se definida como `console`, ou os fluxos stdout/stderr, se definida como `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Se é necessário aguardar o carregamento dos mapas de origem para cada script recebido. Isso tem uma sobrecarga de desempenho e pode ser desativado com segurança ao ficar sem disco, desde que o `rootPath` não esteja desativado.","type":"boolean"},"remoteRoot":{"default":null,"description":"Caminho absoluto para o diretório remoto que contém o programa.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Uma lista de padrões de minimatch para locais (pastas e URLs) em que mapas de origem podem ser usados para resolver arquivos locais. Isso pode ser usado para evitar quebrar incorretamente o código mapeado de origem externa. Padrões podem ser prefixados com \"!\" para excluí-los. Pode ser definido como uma matriz vazia ou nula para evitar a restrição.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Uma lista de padrões nos quais inserir manualmente os pontos de interrupção do ponto de entrada. Isso pode ser útil para dar ao depurador a oportunidade de definir pontos de interrupção ao usar mapas de origem que não existem ou não podem ser detectados antes do lançamento, como [com o Serverless framework](https://github.com/microsoft/vscode -js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Mostrar as chamadas assíncronas que levaram à pilha de chamadas atual.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Uma matriz de nomes de arquivos ou pastas, ou globs de caminho, a serem ignorados durante a depuração. Padrões de estrela e negações são permitidos, por exemplo, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Percorrer automaticamente o código gerado que não pode ser mapeado novamente para a origem original.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Um conjunto de mapeamentos para regravar os locais dos arquivos de origem indicados pelo sourcemap nos respectivos locais no disco.","type":"object"},"sourceMapRena