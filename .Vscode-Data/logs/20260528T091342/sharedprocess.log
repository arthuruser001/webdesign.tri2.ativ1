o. Padrões de estrela e negações são permitidos, por exemplo, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Percorrer automaticamente o código gerado que não pode ser mapeado novamente para a origem original.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Um conjunto de mapeamentos para regravar os locais dos arquivos de origem indicados pelo sourcemap nos respectivos locais no disco.","type":"object"},"sourceMapRenames":{"default":true,"description":"Se usar o mapeamento de \"nomes\" nos sourcemaps. Isso requer a solicitação de conteúdo de origem, o que pode ser lento com determinados depuradores.","type":"boolean"},"sourceMaps":{"default":true,"description":"Usar os source maps JavaScript (caso haja algum).","type":"boolean"},"timeout":{"default":10000,"description":"Repetir a conexão com o Node.js após esse número de milissegundos. O padrão é 10000 ms.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Tempos limite para várias operações de depurador.","markdownDescription":"Tempos limite para várias operações de depurador.","properties":{"hoverEvaluation":{"default":500,"description":"Tempo até que a avaliação de valor para símbolos focalizados seja anulada. Se definido como 0, a avaliação de foco nunca expira.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Tempo extra em milissegundos permitido por sessão a ser gasto esperando que os sourcemaps sejam processados, após o tempo mínimo (sourceMapMinPause) ter sido esgotado","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Tempo mínimo em milissegundos gasto aguardando o processamento de cada sourcemap quando um script está sendo analisado","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Configura qual saída de diagnóstico é produzida.","oneOf":[{"description":"Trace may be set to 'true' to write diagnostic logs to the disk.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Configura onde os logs são gravados no disco.","type":["string","null"]},"stdio":{"description":"Whether to return trace data from the launched application or browser.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Mostrar as chamadas assíncronas que levaram à pilha de chamadas atual.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Uma matriz de nomes de arquivos ou pastas, ou globs de caminho, a serem ignorados durante a depuração. Padrões de estrela e negações são permitidos, por exemplo, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Percorrer automaticamente o código gerado que não pode ser mapeado novamente para a origem original.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Um conjunto de mapeamentos para regravar os locais dos arquivos de origem indicados pelo sourcemap nos respectivos locais no disco.","type":"object"},"sourceMapRenames":{"default":true,"description":"Se usar o mapeamento de \"nomes\" nos sourcemaps. Isso requer a solicitação de conteúdo de origem, o que pode ser lento com determinados depuradores.","type":"boolean"},"sourceMaps":{"default":true,"description":"Usar os source maps JavaScript (caso haja algum).","type":"boolean"},"timeout":{"default":10000,"description":"Repetir a conexão com o Node.js após esse número de milissegundos. O padrão é 10000 ms.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Tempos limite para várias operações de depurador.","markdownDescription":"Tempos limite para várias operações de depurador.","properties":{"hoverEvaluation":{"default":500,"description":"Tempo até que a avaliação de valor para símbolos focalizados seja anulada. Se definido como 0, a avaliação de foco nunca expira.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Tempo extra em milissegundos permitido por sessão a ser gasto esperando que os sourcemaps sejam processados, após o tempo mínimo (sourceMapMinPause) ter sido esgotado","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Tempo mínimo em milissegundos gasto aguardando o processamento de cada sourcemap quando um script está sendo analisado","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Configura qual saída de diagnóstico é produzida.","oneOf":[{"description":"Trace may be set to 'true' to write diagnostic logs to the disk.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Configura onde os logs são gravados no disco.","type":["string","null"]},"stdio":{"description":"Whether to return trace data from the launched application or browser.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Procurará uma guia com esta url exata e anexará a ela, se encontrado","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Pesquisará uma página com essa URL e a anexará a ela, se encontrada. Pode ter * curingas.","type":"string"},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Uma lista de padrões glob de arquivo para localizar os componentes `*.vue`. Por padrão, pesquisa todo o workspace. Isso precisa ser especificado devido a pesquisas extras que os sourcemaps do Vue exigem na CLI 4 do Vue. Você pode desabilitar esse processamento especial definindo-o como uma matriz vazia.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Especifica o caminho absoluto do workspace para a raiz do servidor Web. Usado para resolver caminhos, como '/app.js', para arquivos no disco. A abreviação de um pathMapping como \"/\"","tags":["setup"],"type":"string"}}},"launch":{"properties":{"cascadeTerminateToConfigurations":{"default":[],"description":"Uma lista de sessões de depuração que, quando esta sessão de depuração for terminada, também será interrompida.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Personalizar a descrição textual que o depurador mostra para objetos (variáveis locais etc.). Amostras:\r\n      1. this.toString() // chamará toString para imprimir todos os objetos\r\n      2. this.customDescription ? this.customDescription() : defaultValue // Use o método customDescription se disponível, se não retornar defaultValue\r\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Use o método customDescription, se disponível, se não retornar defaultValue\r\n","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Personalize as propriedades mostradas para um objeto no depurador (variáveis locais, etc...). Exemplos:\r\n    1. { ...this, extraProperty: '12345' } // Adicionar uma extraProperty 12345 a todos os objetos\r\n    2. this.customProperties ? this.customProperties() : this // Usar o método customProperties, se disponível, caso contrário, usar as propriedades em this (as propriedades padrão)\r\n    3. function () { return this.customProperties ? this.customProperties() : this } // Usar o método customDescription, se disponível, caso contrário, retornar as propriedades padrão\r\n\r\n    Preterido: esta é uma implementação temporária deste recurso até que haja tempo para implementá-lo da maneira descrita aqui: https://github.com/microsoft/vscode/issues/102181","type":"string"},"disableNetworkCache":{"default":true,"description":"Controla se deve ignorar o cache de rede para cada solicitação","type":"boolean"},"enableContentValidation":{"default":true,"description":"Ativa/desativa se deve ser feita uma verificação se os conteúdos dos arquivos no disco correspondem aos carregados no runtime. Isso é útil em uma variedade de cenários e exigido em alguns, mas poderá causar problemas se você tiver transformação de scripts do lado do servidor, por exemplo.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Alterna se o depurador tentará ler símbolos de depuração DWARF do WebAssembly, o que pode consumir muitos recursos. Requer a extensão 'ms-vscode.wasm-dwarf-debugging' para funcionar.","type":"boolean"},"inspectUri":{"default":null,"description":"Formato a ser usado para reescrever o inspectUri: é uma cadeia de caracteres de modelo que interpola chaves em `{curlyBraces}`. As chaves disponíveis são:\r\n – `url.*` é o endereço analisado do aplicativo em execução. Por exemplo, `{url.port}`, `{url.hostname}`\r\n – `port` é a porta de depuração na qual o Chrome está escutando. \r\n– `browserInspectUri` é o URI do inspetor no navegador iniciado\r\n – `browserInspectUriPath` é a parte de caminho do URI do inspetor no navegador iniciado (por exemplo: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\r\n – `wsProtocol` é o protocolo do WebSocket com dica. Ele será configurado como `wss` se a URL original for `https`, caso contrário, ele será configurado como `ws`.\r\n","type":["string","null"]},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Quando os source maps estão habilitados, esses padrões glob especificam os arquivos JavaScript gerados. Quando um padrão começa com '!', os arquivos são excluídos. Quando não especificado, o código gerado é esperado no mesmo diretório que sua origem.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"De onde capturar as mensagens de saída: a API de depuração padrão, se definida como `console`, ou os fluxos stdout/stderr, se definida como `std`."},"pathMapping":{"default":{},"description":"Um mapeamento de URLs/caminhos para pastas locais, para resolver scripts no Navegador para scripts em disco","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Se é necessário aguardar o carregamento dos mapas de origem para cada script recebido. Isso tem uma sobrecarga de desempenho e pode ser desativado com segurança ao ficar sem disco, desde que o `rootPath` não esteja desativado.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Se os scripts são carregados individualmente como sourcemaps exclusivos contendo o nome base do arquivo de origem. Essa opção pode ser definida para otimizar o tratamento do sourcemap ao lidar com muitos scripts pequenos. Se ela for definida como \"auto\", detectaremos casos conhecidos em que essa opção é apropriada.","enum":["yes","no","auto"],"type":"string"},"resolveSourceMapLocations":{"default":null,"description":"Uma lista de padrões de minimatch para locais (pastas e URLs) em que mapas de origem podem ser usados para resolver arquivos locais. Isso pode ser usado para evitar quebrar incorretamente o código mapeado de origem externa. Padrões podem ser prefixados com \"!\" para excluí-los. Pode ser definido como uma matriz vazia ou nula para evitar a restrição.","items":{"type":"string"},"type":["array","null"]},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Configures a web server to start up. Takes the same configuration as the 'node' launch task.","properties":{"args":{"default":[],"description":"Argumentos da linha de comando passados para o programa.\r\n\r\nNão é possível ser uma matriz de cadeias de caracteres ou uma única cadeia de caracteres. Quando o programa é iniciado em um terminal, definir essa propriedade como uma única cadeia de caracteres fará com que os argumentos não sejam escapados para o shell.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Se definido, será anexado ao processo por meio da porta especificada. Isso geralmente não é mais necessário para programas do Node.js e perde a capacidade de depurar processos filho, mas pode ser útil em cenários diferentes, como com inicializações Deno e Docker. Se definido como 0, uma porta aleatória será escolhida e --inspect-brk será adicionado aos argumentos de inicialização automaticamente.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Anexar automaticamente o depurador a novos processos filho.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Uma lista de sessões de depuração que, quando esta sessão de depuração for terminada, também será interrompida.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"A localização na qual o destino de depuração será iniciado.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Console de Depuração do VS Code (que não dá suporte à leitura da entrada de um programa)","Terminal integrado do VS Code","Terminal externo que pode ser configurado por meio das configurações de usuário"],"type":"string"},"customDescriptionGenerator":{"description":"Personalizar a descrição textual que o depurador mostra para objetos (variáveis locais etc.). Amostras:\r\n      1. this.toString() // chamará toString para imprimir todos os objetos\r\n      2. this.customDescription ? this.customDescription() : defaultValue // Use o método customDescription se disponível, se não retornar defaultValue\r\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Use o método customDescription, se disponível, se não retornar defaultValue\r\n","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Personalize as propriedades mostradas para um objeto no depurador (variáveis locais, etc...). Exemplos:\r\n    1. { ...this, extraProperty: '12345' } // Adicionar uma extraProperty 12345 a todos os objetos\r\n    2. this.customProperties ? this.customProperties() : this // Usar o método customProperties, se disponível, caso contrário, usar as propriedades em this (as propriedades padrão)\r\n    3. function () { return this.customProperties ? this.customProperties() : this } // Usar o método customDescription, se disponível, caso contrário, retornar as propriedades padrão\r\n\r\n    Preterido: esta é uma implementação temporária deste recurso até que haja tempo para implementá-lo da maneira descrita aqui: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Caminho absoluto para o diretório de trabalho do programa que está sendo depurado. Se você definir localRoot, cwd corresponderá ao valor, caso contrário, retornará para workspaceFolder","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Ativa/desativa se deve ser feita uma verificação se os conteúdos dos arquivos no disco correspondem aos carregados no runtime. Isso é útil em uma variedade de cenários e exigido em alguns, mas poderá causar problemas se você tiver transformação de scripts do lado do servidor, por exemplo.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Alterna se o depurador tentará ler símbolos de depuração DWARF do WebAssembly, o que pode consumir muitos recursos. Requer a extensão 'ms-vscode.wasm-dwarf-debugging' para funcionar.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Variáveis de ambiente passadas para o programa. O valor `null` remove a variável do ambiente.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Caminho absoluto para um arquivo que contém as definições de variável de ambiente.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Habilite a inspeção experimental do Node.js. Quando definido como `auto`, ela é habilitada em versões do Node.js compatíveis. Ela pode ser definida como `on` ou `off` para ser habilitada ou desabilitada explicitamente.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Configura como os processos de depuração são encerrado quando a sessão é interrompida. Pode ser:\r\n\r\n– forceful (padrão): divide a árvore de processos de maneira forçada. Envia SIGKILL no posix ou `taskkill.exe /F` no Windows.\r\n– polite: divide normalmente a árvore de processos. É possível que a execução de processos de comportamento inadequado continue após esse tipo de desligamento. Envia SIGTERM no posix ou `taskkill.exe` sem nenhum sinalizador `/F` (forçar) no Windows.\r\n– none: não ocorrerá nenhum encerramento.","type":"string"},"localRoot":{"default":null,"description":"Caminho para o diretório local que contém o programa.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Permite que você especifique explicitamente a versão do Nó que está em execução, que pode ser usada para desabilitar ou habilitar determinados comportamentos em casos que a detecção de versão automática não funciona.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Quando os source maps estão habilitados, esses padrões glob especificam os arquivos JavaScript gerados. Quando um padrão começa com '!', os arquivos são excluídos. Quando não especificado, o código gerado é esperado no mesmo diretório que sua origem.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"De onde capturar as mensagens de saída: a API de depuração padrão, se definida como `console`, ou os fluxos stdout/stderr, se definida como `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Se é necessário aguardar o carregamento dos mapas de origem para cada script recebido. Isso tem uma sobrecarga de desempenho e pode ser desativado com segurança ao ficar sem disco, desde que o `rootPath` não esteja desativado.","type":"boolean"},"profileStartup":{"default":true,"description":"Se true, iniciará a criação de perfil assim que o processo for iniciado","type":"boolean"},"program":{"default":"","description":"Caminho absoluto para o programa. O valor gerado é deduzido olhando para package.json e os arquivos abertos. Edite esse atributo.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Caminho absoluto para o diretório remoto que contém o programa.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Uma lista de padrões de minimatch para locais (pastas e URLs) em que mapas de origem podem ser usados para resolver arquivos locais. Isso pode ser usado para evitar quebrar incorretamente o código mapeado de origem externa. Padrões podem ser prefixados com \"!\" para excluí-los. Pode ser definido como uma matriz vazia ou nula para evitar a restrição.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Tentar se reconectar com o programa se a conexão for perdida. Se definido como `true`, tentaremos uma vez por segundo, para sempre. Você pode personalizar o intervalo e o número máximo de tentativas especificando `delay` e `maxAttempts` em um objeto.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Argumentos opcionais passados para o executável do runtime.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"O runtime a ser usado. Um caminho absoluto ou o nome de um runtime disponível em PATH. Se omitido, será presumido `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Uma lista de padrões nos quais inserir manualmente os pontos de interrupção do ponto de entrada. Isso pode ser útil para dar ao depurador a oportunidade de definir pontos de interrupção ao usar mapas de origem que não existem ou não podem ser detectados antes do lançamento, como [com o Serverless framework](https://github.com/microsoft/vscode -js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Versão do runtime `node` a ser usada. Exige `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Mostrar as chamadas assíncronas que levaram à pilha de chamadas atual.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Uma matriz de nomes de arquivos ou pastas, ou globs de caminho, a serem ignorados durante a depuração. Padrões de estrela e negações são permitidos, por exemplo, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Percorrer automaticamente o código gerado que não pode ser mapeado novamente para a origem original.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Um conjunto de mapeamentos para regravar os locais dos arquivos de origem indicados pelo sourcemap nos respectivos locais no disco.","type":"object"},"sourceMapRenames":{"default":true,"description":"Se usar o mapeamento de \"nomes\" nos sourcemaps. Isso requer a solicitação de conteúdo de origem, o que pode ser lento com determinados depuradores.","type":"boolean"},"sourceMaps":{"default":true,"description":"Usar os source maps JavaScript (caso haja algum).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Parar o programa automaticamente após a inicialização.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Repetir a conexão com o Node.js após esse número de milissegundos. O padrão é 10000 ms.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Tempos limite para várias operações de depurador.","markdownDescription":"Tempos limite para várias operações de depurador.","properties":{"hoverEvaluation":{"default":500,"description":"Tempo até que a avaliação de valor para símbolos focalizados seja anulada. Se definido como 0, a avaliação de foco nunca expira.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Tempo extra em milissegundos permitido por sessão a ser gasto esperando que os sourcemaps sejam processados, após o tempo mínimo (sourceMapMinPause) ter sido esgotado","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Tempo mínimo em milissegundos gasto aguardando o processamento de cada sourcemap quando um script está sendo analisado","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Configura qual saída de diagnóstico é produzida.","oneOf":[{"description":"Trace may be set to 'true' to write diagnostic logs to the disk.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"de