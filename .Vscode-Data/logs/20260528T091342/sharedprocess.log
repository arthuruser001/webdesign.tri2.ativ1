t.foreground","highContrastLight":"editorInlayHint.foreground"}}],"configurationDefaults":{"[git-commit]":{"editor.rulers":[50,72],"editor.wordWrap":"off","workbench.editor.restoreViewState":false},"[git-rebase]":{"workbench.editor.restoreViewState":false}},"viewsWelcome":[{"view":"scm","contents":"Se você quiser usar os recursos do Git, habilite o Git em suas [configurações](command:workbench.action.openSettings?%5B%22git.enabled%22%5D).\r\nPara saber mais sobre como usar o Git e o controle do código-fonte no VS Code [leia nossos documentos](https://aka.ms/vscode-scm).","when":"!config.git.enabled"},{"view":"scm","contents":"Instale o Git, um sistema de controle do código-fonte popular, para acompanhar alterações de código e colaborar com outras pessoas. Saiba mais em nossos [guias do Git](https://aka.ms/vscode-scm).","when":"config.git.enabled && git.missing && remoteName != ''"},{"view":"scm","contents":"[Baixe o Git para macOS](https://git-scm.com/download/mac)\r\nDepois de instalar, [recarregue](command:workbench.action.reloadWindow) (ou [solucione o probleme](command:git.showOutput)). Provedores de controle do código-fonte adicionais podem ser instalados [a partir do Marketplace](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22).","when":"config.git.enabled && git.missing && remoteName == '' && isMac"},{"view":"scm","contents":"[Baixar o Git para Windows](https://git-scm.com/download/win)\r\nDepois de instalar, [recarregue](command:workbench.action.reloadWindow) (ou [solucione o problema](command:git.showOutput)). Provedores de controle do código-fonte adicionais podem ser instalados [a partir do Marketplace](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22).","when":"config.git.enabled && git.missing && remoteName == '' && isWindows"},{"view":"scm","contents":"O controle do código-fonte depende da instalação do Git.\r\n[Baixe o Git para Linux](https://git-scm.com/download/linux)\r\nDepois de instalar, [recarregue](command:workbench.action.reloadWindow) (ou [solucione o problema](command:git.showOutput)). Provedores de controle do código-fonte adicionais podem ser instalados [a partir do Marketplace](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22).","when":"config.git.enabled && git.missing && remoteName == '' && isLinux"},{"view":"scm","contents":"Para usar os recursos do Git, você pode abrir uma pasta contendo um repositório Git ou clonar de um URL.\r\n[Abrir Pasta](command:vscode.openFolder)\r\n[Clonar Repositório](command:git.cloneRecursive)\r\nPara saber mais sobre como usar o Git e o controle do código-fonte no VS Code [leia nossos documentos](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && workbenchState == empty && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0","enablement":"git.state == initialized","group":"2_open@1"},{"view":"scm","contents":"O espaço de trabalho atualmente aberto não tem pastas contendo os repositórios Git.\r\n[Adicionar Pasta ao Espaço de Trabalho](command:workbench.action.addRootFolder)\r\nPara saber mais sobre como usar o Git e o controle do código-fonte no VS Code [leia nossos documentos](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && workbenchState == workspace && workspaceFolderCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0","enablement":"git.state == initialized","group":"2_open@1"},{"view":"scm","contents":"Verificando a pasta de repositórios Git...","when":"config.git.enabled && !git.missing && workbenchState == folder && workspaceFolderCount != 0 && git.state != initialized"},{"view":"scm","contents":"Verificando o espaço de trabalho de repositórios Git...","when":"config.git.enabled && !git.missing && workbenchState == workspace && workspaceFolderCount != 0 && git.state != initialized"},{"view":"scm","contents":"A pasta atualmente aberta não tem um repositório Git. Você pode inicializar um repositório que habilitará recursos de controle de origem desenvolvidos pelo Git.\r\n[Inicializar Repositório](command:git.init?%5Btrue%5D)\r\nPara saber mais sobre como usar o Git e o controle do código-fonte no VS Code [leia nossos documentos](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && workbenchState == folder && scm.providerCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0 && remoteName != 'codespaces'","group":"5_scm@1"},{"view":"scm","contents":"O espaço de trabalho atualmente aberto não tem pastas contendo os repositórios Git. Você pode inicializar um repositório em uma pasta que habilitará recursos de controle de origem desenvolvidos pelo Git.\r\n[Inicializar o Repositório](command:git.init)\r\nPara saber mais sobre como usar o Git e o controle do código-fonte no VS Code [leia nossos documentos](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && workbenchState == workspace && workspaceFolderCount != 0 && scm.providerCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0 && remoteName != 'codespaces'","group":"5_scm@1"},{"view":"scm","contents":"Um repositório Git foi encontrado nas pastas pai do espaço de trabalho ou nos arquivos abertos.\r\n[Abrir Repositório](command:git.openRepositoriesInParentFolders)\r\nUse a configuração [git.openRepositoryInParentFolders](command:workbench.action.openSettings?%5B%22git.openRepositoryInParentFolders%22%5D) para controlar se os repositórios Git em pastas pai do espaços de trabalho ou arquivos abertos estão abertos. Para saber mais [leia nossos documentos](https://aka.ms/vscode-git-repository-in-parent-folders).","when":"config.git.enabled && !git.missing && git.state == initialized && git.parentRepositoryCount == 1"},{"view":"scm","contents":"Repositórios Git foram encontrados nas pastas pai do espaço de trabalho ou nos arquivos abertos.\r\n[Abrir Repositório](command:git.openRepositoriesInParentFolders)\r\nUse a configuração [git.openRepositoryInParentFolders](command:workbench.action.openSettings?%5B%22git.openRepositoryInParentFolders%22%5D) para controlar se os repositórios Git nas pastas pai do espaço de trabalho ou nos arquivos abertos estão abertos. Para saber mais [leia nossos documentos](https://aka.ms/vscode-git-repository-in-parent-folders).","when":"config.git.enabled && !git.missing && git.state == initialized && git.parentRepositoryCount > 1"},{"view":"scm","contents":"O repositório Git detectado é potencialmente não seguro, pois a pasta pertence a alguém que não é o usuário atual.\r\n[Gerenciar Repositórios Não Seguros](command:git.manageUnsafeRepositories)\r\nPara saber mais sobre repositórios são seguros [leia nossos documentos](https://aka.ms/vscode-git-unsafe-repository).","when":"config.git.enabled && !git.missing && git.state == initialized && git.unsafeRepositoryCount == 1"},{"view":"scm","contents":"Os repositórios Git detectados são potencialmente não seguros, pois as pastas pertencem a alguém que não é o usuário atual.\r\n[Gerenciar Repositórios Não Seguros](command:git.manageUnsafeRepositories)\r\nPara saber mais sobre repositórios são seguros [leia nossos documentos](https://aka.ms/vscode-git-unsafe-repository).","when":"config.git.enabled && !git.missing && git.state == initialized && git.unsafeRepositoryCount > 1"},{"view":"scm","contents":"Foi encontrado um repositório Git que estava fechado anteriormente.\r\n[Reabrir Repositório Fechado](command:git.reopenClosedRepositories)\r\nPara saber mais sobre como usar o Git e o controle do código-fonte no VS Code [leia nossos documentos](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && git.closedRepositoryCount == 1"},{"view":"scm","contents":"