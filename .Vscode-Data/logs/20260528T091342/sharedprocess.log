tion":{"type":"array","markdownDescription":"Lista de branches protegidos. Por padrão, um prompt é mostrado antes que as alterações sejam confirmadas em um branch protegido. O prompt pode ser controlado usando a configuração `#git.branchProtectionPrompt#`.","items":{"type":"string"},"default":[],"scope":"resource"},"git.branchProtectionPrompt":{"type":"string","description":"Controla se um prompt está sendo mostrado antes que as alterações sejam confirmadas em um branch protegido.","enum":["alwaysCommit","alwaysCommitToNewBranch","alwaysPrompt"],"enumDescriptions":["Sempre faça commit nas alterações no branch protegido.","Sempre fazer commit nas alterações em um novo branch.","Sempre solicitar antes que as alterações sejam confirmadas em um branch protegido."],"default":"alwaysPrompt","scope":"resource"},"git.branchValidationRegex":{"type":"string","description":"Uma expressão regular para validar novos nomes de branch.","default":""},"git.branchWhitespaceChar":{"type":"string","description":"O caractere para substituir o espaço em branco em novos nomes de branch e para separar segmentos de um nome de branch gerado aleatoriamente.","default":"-"},"git.branchRandomName.enable":{"type":"boolean","description":"Controla se um nome aleatório é gerado ao criar um novo branch.","default":false,"scope":"resource","agentsWindow":{"default":true}},"git.branchRandomName.dictionary":{"type":"array","markdownDescription":"Lista de dicionários usados para o nome do branch gerado aleatoriamente. Cada valor representa o dicionário usado para gerar o segmento do nome da ramificação. Dicionários suportados: `adjetivos`, `animais`, `cores` e `números`.","items":{"type":"string","enum":["adjectives","animals","colors","numbers"],"enumDescriptions":["Um adjetivo aleatório","Um nome de animal aleatório","Um nome de cor aleatório","Um número aleatório entre 100 e 999"]},"minItems":1,"maxItems":5,"default":["adjectives","animals"],"scope":"resource"},"git.confirmSync":{"type":"boolean","description":"Confirme antes de sincronizar os repositórios Git.","default":true,"agentsWindow":{"default":false,"readOnly":true}},"git.confirmCommittedDelete":{"type":"boolean","description":"Solicitar confirmação antes de excluir arquivos confirmados com o Git.","default":true},"git.countBadge":{"type":"string","enum":["all","tracked","off"],"enumDescriptions":["Contar todas as alterações.","Contar somente as alterações controladas.","Desligar o contador."],"description":"Controla o selo da contagem de Git.","default":"all","scope":"resource"},"git.checkoutType":{"type":"array","items":{"type":"string","enum":["local","tags","remote"],"enumDescriptions":["Branches locais","Tags","Branches remotos"]},"uniqueItems":true,"markdownDescription":"Controla que tipo de referências do Git são listadas ao executar `Checkout to...`.","default":["local","remote","tags"]},"git.ignoreLegacyWarning":{"type":"boolean","description":"Ignora o aviso de Git herdado.","default":false},"git.ignoreMissingGitWarning":{"type":"boolean","description":"Ignora o aviso quando o Git está ausente.","default":false},"git.ignoreWindowsGit27Warning":{"type":"boolean","description":"Ignora o aviso quando as versões 2.25 – 2.26 do Git estão instaladas no Windows.","default":false},"git.ignoreLimitWarning":{"type":"boolean","description":"Ignora o aviso quando há muitas alterações em um repositório.","default":false},"git.ignoreRebaseWarning":{"type":"boolean","description":"Ignora o aviso quando parece que a base do branch pode ter sido trocada ao efetuar pull.","default":false},"git.defaultCloneDirectory":{"type":["string","null"],"default":null,"scope":"machine","description":"O local padrão para clonar um repositório Git."},"git.useEditorAsCommitInput":{"type":"boolean","description":"Controla se um editor de texto completo será usado para criar mensagens de confirmação, sempre que nenhuma mensagem for fornecida na caixa de entrada de confirmação.","default":true},"git.verboseCommit":{"type":"boolean","scope":"resource","markdownDescription":"Habilite a saída detalhada quando `#git.useEditorAsCommitInput#` estiver habilitado.","default":false},"git.enableSmartCommit":{"type":"boolean","scope":"resource","description":"Confirmar todas as alterações quando não houver alterações preparadas.","default":false},"git.smartCommitChanges":{"type":"string","enum":["all","tracked"],"enumDescriptions":["Preparar automaticamente todas as alterações.","Somente preparar automaticamente as alterações controladas."],"scope":"resource","description":"Controlar quais alterações são automaticamente testadas por Confirmação Inteligente.","default":"all"},"git.suggestSmartCommit":{"type":"boolean","scope":"resource","description":"Sugere habilitar a confirmação inteligente (confirmar todas as alterações quando não há alterações preparadas).","default":true},"git.enableCommitSigning":{"type":"boolean","scope":"resource","description":"Habilita a assinatura de confirmação com GPG, X.509 ou SSH.","default":false},"git.confirmEmptyCommits":{"type":"boolean","scope":"resource","description":"Sempre confirmar a criação de confirmações vazias para o comando 'Git: Commit Empty'.","default":true},"git.decorations.enabled":{"type":"boolean","default":true,"description":"Controla se o Git contribui com cores e selos para o Explorador e para a exibição Editores Abertos."},"git.enableStatusBarSync":{"type":"boolean","default":true,"description":"Controla se o comando de sincronização do Git aparece na barra de status.","scope":"resource"},"git.followTagsWhenSync":{"type":"boolean","scope":"resource","default":false,"description":"Envie todas as tags anotadas ao executar o comando de sincronização."},"git.replaceTagsWhenPull":{"type":"boolean","scope":"resource","default":false,"description":"Substitua automaticamente as marcas locais por marcas remotas em caso de conflito ao executar o comando pull."},"git.promptToSaveFilesBeforeStash":{"type":"string","enum":["always","staged","never"],"enumDescriptions":["Verificar se há arquivos não salvos.","Verificar somente os arquivos preparados não salvos.","Desabilitar essa verificação."],"scope":"resource","default":"always","description":"Controla se o Git deve verificar se há arquivos não salvos antes de fazer stash das alterações."},"git.promptToSaveFilesBeforeCommit":{"type":"string","enum":["always","staged","never"],"enumDescriptions":["Verificar se há arquivos não salvos.","Verificar somente os arquivos preparados não salvos.","Desabilitar esta verificação."],"scope":"resource","default":"always","description":"Controla se o Git deve verificar arquivos não salvos antes de confirmar."},"git.postCommitCommand":{"type":"string","enum":["none","push","sync"],"enumDescriptions":["Não executar nenhum comando após uma confirmação.","Execute 'git push' após um commit bem-sucedido.","Execute 'git pull' e 'git push' após um commit bem-sucedido."],"markdownDescription":"Execute um comando git após um commit bem-sucedido.","scope":"resource","default":"none","agentsWindow":{"default":"none","readOnly":true}},"git.rememberPostCommitCommand":{"type":"boolean","description":"Lembre-se do último comando git executado após um commit.","scope":"resource","default":false,"agentsWindow":{"default":false,"readOnly":true}},"git.openAfterClone":{"type":"string","enum":["always","alwaysNewWindow","whenNoFolderOpen","prompt"],"enumDescriptions":["Sempre abrir o repositório na janela atual.","Sempre abrir o repositório em uma nova janela.","Abrir somente na janela atual quando não for aberta nenhuma pasta.","Sempre solicitar uma ação."],"default":"prompt","description":"Controla se um repositório deve ser aberto automaticamente após a clonagem."},"git.showInlineOpenFileAction":{"type":"boolean","default":true,"description":"Controla se uma ação de abertura de arquivo embutida deve ser mostrada no modo de exibição de alterações do Git."},"git.showPushSuccessNotification":{"type":"boolean","description":"Controla se uma notificação deve ser mostrada quando um envio por push é bem-sucedido.","default":false},"git.inputValidation":{"type":"boolean","default":false,"description":"Controla se devem ser mostrados os diagnósticos de validação de entrada da mensagem de confirmação."},"git.inputValidationLength":{"type":"number","default":72,"description":"Controla o limite de tamanho da mensagem de confirmação para mostrar um aviso."},"git.inputValidationSubjectLength":{"type":["number","null"],"default":50,"markdownDescription":"Controla o limite de comprimento do assunto da mensagem de confirmação para mostrar um aviso. Remover definição para herdar o valor de `#git.inputValidationLength#`."},"git.detectSubmodules":{"type":"boolean","scope":"resource","default":true,"description":"Controla se os submódulos do Git devem ser detectados automaticamente."},"git.detectSubmodulesLimit":{"type":"number","scope":"resource","default":10,"description":"Controla o limite de submódulos do Git detectados."},"git.detectWorktrees":{"type":"boolean","scope":"resource","default":false,"description":"Controla se as árvores de trabalho do Git devem ser detectadas automaticamente.","agentsWindow":{"default":false}},"git.detectWorktreesLimit":{"type":"number","scope":"resource","default":50,"description":"Controla o limite de árvores de trabalho do Git detectado."},"git.worktreeIncludeFiles":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Configurar [padrões glob](https://aka.ms/vscode-glob-patterns) para arquivos e pastas incluídos ao criar uma árvore de trabalho. Somente arquivos e pastas que correspondam aos padrões e estejam listados em `.gitignore` serão copiados para a árvore de trabalho recém-criada.","scope":"resource","tags":["experimental"]},"git.alwaysShowStagedChangesResourceGroup":{"type":"boolean","scope":"resource","default":false,"description":"Sempre mostrar o grupo de recursos Alterações em Etapas."},"git.alwaysSignOff":{"type":"boolean","scope":"resource","default":false,"description":"Controla o sinalizador de aprovação para todas as confirmações."},"git.addAICoAuthor":{"type":"string","enum":["off","chatAndAgent","all"],"enumDescriptions":["Nunca adicione o trailer de coautoria de IA.","Adicione o trailer de coautoria de IA quando o código de chat ou edições de agente estiver incluído.","Adicione o trailer de coautoria de IA sempre que qualquer código gerado por IA for incluído, como conclusões embutidas, chat ou edições de agente."],"scope":"resource","default":"off","description":"Controla se um trailer \"Co-authored-by\" é adicionado automaticamente à mensagem do commit quando o código gerado pela IA for incluído no commit."},"git.ignoreSubmodules":{"type":"boolean","scope":"resource","default":false,"description":"Ignorar as modificações em submódulos na árvore de arquivos."},"git.ignoredRepositories":{"type":"array","items":{"type":"string"},"default":[],"scope":"window","description":"Lista de repositórios Git a serem ignorados."},"git.scanRepositories":{"type":"array","items":{"type":"string"},"default":[],"scope":"resource","description":"Lista de caminhos para pesquisar os repositórios Git."},"git.showProgress":{"type":"boolean","description":"Controla se as ações do Git devem mostrar o progresso.","default":true,"scope":"resource","agentsWindow":{"default":false,"readOnly":true}},"git.rebaseWhenSync":{"type":"boolean","scope":"resource","default":false,"description":"Força o Git a usar a troca de base ao executar o comando de sincronização."},"git.pullBeforeCheckout":{"type":"boolean","scope":"resource","default":false,"description":"Controla se uma ramificação que não possui commits de saída é avançada antes do check-out."},"git.fetchOnPull":{"type":"boolean","scope":"resource","default":false,"description":"Quando habilitado, busque todas as ramificações efetuando pull. Caso contrário, busque apenas a atual."},"git.pruneOnFetch":{"type":"boolean","scope":"resource","default":false,"description":"Fazer a remoção durante a busca."},"git.pullTags":{"type":"boolean","scope":"resource","default":true,"description":"Buscar todas as marcas ao efetuar pull."},"git.autoStash":{"type":"boolean","scope":"resource","default":false,"description":"Efetuar stash das alterações antes de acioná-las e restaurá-las após o êxito."},"git.allowForcePush":{"type":"boolean","default":false,"description":"Controla se o envio forçado por push (com ou sem concessão) está habilitado."},"git.useForcePushWithLease":{"type":"boolean","default":true,"description":"Controla se o envio por push forçado usa a variante force-with-lease mais segura."},"git.useForcePushIfIncludes":{"type":"boolean","default":true,"markdownDescription":"Controla se o envio forçado por push usa a variante force-if-includes mais segura. Observação: essa configuração requer que a configuração `#git.useForcePushWithLease#` esteja habilitada e a versão do Git `2.30.0` ou posterior."},"git.confirmForcePush":{"type":"boolean","default":true,"description":"Controla se é necessário solicitar confirmação antes de forçar o envio por push."},"git.allowNoVerifyCommit":{"type":"boolean","default":false,"description":"Controla se as confirmações sem executar ganchos pre-commit e commit-msg são permitidas."},"git.confirmNoVerifyCommit":{"type":"boolean","default":true,"description":"Controla se deve solicitar confirmação antes de confirmar sem verificação."},"git.closeDiffOnOperation":{"type":"boolean","scope":"resource","default":false,"description":"Controla se o editor de comparação deve ser fechado automaticamente quando as alterações são ocultadas, confirmadas, descartadas, preparadas ou não."},"git.openDiffOnClick":{"type":"boolean","scope":"resource","default":true,"description":"Controla se o editor de comparação deve ser aberto ao clicar em uma alteração. Caso contrário, o editor regular será aberto."},"git.supportCancellation":{"type":"boolean","scope":"resource","default":false,"description":"Controla se uma notificação aparece durante a execução da ação de sincronização, o que permite ao usuário cancelar a operação."},"git.branchSortOrder":{"type":"string","enum":["committerdate","alphabetically"],"default":"committerdate","description":"Controla a ordem de classificação de ramificações."},"git.untrackedChanges":{"type":"string","enum":["mixed","separate","hidden"],"enumDescriptions":["Todas as alterações, controladas e não controladas, aparecem juntas e se comportam igualmente.","As alterações não controladas são exibidas separadamente no modo de exibição de Controle do Código-fonte. Elas também são excluídas de várias ações.","As alterações não controladas são ocultas e excluídas de várias ações."],"default":"mixed","description":"Controla como as alterações não controladas se comportam.","scope":"resource"},"git.requireGitUserConfig":{"type":"boolean","description":"Controla se a configuração explícita do usuário do Git deve ser exigida ou se o Git pode adivinhar a configuração quando ela estiver ausente.","default":true,"scope":"resource"},"git.showCommitInput":{"type":"boolean","scope":"resource","default":true,"description":"Controla se a entrada de confirmação deve ser mostrada no painel de controle do código-fonte do Git."},"git.terminalAuthentication":{"type":"boolean","default":true,"description":"Controla se o VS Code deve ser habilitado para ser o manipulador de autenticação para processos Git gerados no Terminal Integrado. Observação: os terminais precisam ser reiniciados para haver uma alteração nesta configuração."},"git.terminalGitEditor":{"type":"boolean","default":false,"description":"Controla se o VS Code deve ser ativado como editor git para processos git gerados no terminal integrado. Nota: Os terminais precisam ser reiniciados para detectar uma alteração nesta configuração."},"git.useCommitInputAsStashMessage":{"type":"boolean","scope":"resource","default":false,"description":"Controla se a mensagem da caixa de entrada de commit deve ser usada como a mensagem de stash padrão."},"git.useIntegratedAskPass":{"type":"boolean","default":true,"description":"Controla se o GIT_ASKPASS deve ser substituído para usar a versão integrada."},"git.githubAuthentication":{"markdownDeprecationMessage":"This setting is now deprecated, please use `#github.gitAuthentication#` instead."},"git.timeline.date":{"type":"string","enum":["committed","authored"],"enumDescriptions":["Usar a data confirmada","Usar a data de criação"],"default":"committed","description":"Controla qual data deve ser usada para os itens na exibição Linha do tempo.","scope":"window"},"git.timeline.showAuthor":{"type":"boolean","default":true,"description":"Controla se o autor do commit deve ser mostrado na exibição Linha do tempo.","scope":"window"},"git.timeline.showUncommitted":{"type":"boolean","default":false,"description":"Controla se as alterações não confirmadas devem ser mostradas no modo de exibição de Linha do Tempo.","scope":"window"},"git.showActionButton":{"type":"object","additionalProperties":false,"description":"Controla se um botão de ação é mostrado na visualização Source Control.","properties":{"commit":{"type":"boolean","description":"Mostre um botão de ação para confirmar as alterações quando a ramificação local tiver modificado os arquivos prontos para serem confirmados."},"publish":{"type":"boolean","description":"Mostre um botão de ação para publicar a ramificação local quando ela não tiver uma ramificação remota de rastreamento."},"sync":{"type":"boolean","description":"Mostre um botão de ação para sincronizar as alterações quando a ramificação local estiver à frente ou atrás da ramificação remota."}},"default":{"commit":true,"publish":true,"sync":true},"scope":"resource"},"git.statusLimit":{"type":"number","scope":"resource","default":10000,"description":"Controla como limitar o número de alterações que podem ser analisadas a partir do comando de status do Git. Pode ser definido como 0 para nenhum limite."},"git.repositoryScanIgnoredFolders":{"type":"array","items":{"type":"string"},"default":["node_modules"],"scope":"resource","markdownDescription":"Lista de pastas ignoradas durante a verificação de repositórios Git quando '#git.autoRepositoryDetection#' está definido como 'true' ou 'subFolders'."},"git.repositoryScanMaxDepth":{"type":"number","scope":"resource","default":1,"markdownDescription":"Controla a profundidade usada ao verificar as pastas do workspace para repositórios Git quando `#git.autoRepositoryDetection#` está definido como `true` ou` subFolders`. Pode ser definido como `-1` para nenhum limite."},"git.commandsToLog":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Lista de comandos git (por exemplo: commit, push) que teriam seu 'stdout' registrado no [git output](command:git.showOutput). Se o comando git tiver um gancho do lado do cliente configurado, o 'stdout' do gancho do lado do cliente também será registrado no [git output](command:git.showOutput)."},"git.mergeEditor":{"type":"boolean","default":false,"markdownDescription":"Abra o editor de mesclagem para arquivos que estão atualmente em conflito.","scope":"window"},"git.optimisticUpdate":{"type":"boolean","default":true,"markdownDescription":"Controla se o estado da exibição do Controle do Código-Fonte deve ser atualizado de forma otimizada após a execução dos comandos git.","scope":"resource","tags":["experimental"]},"git.openRepositoryInParentFolders":{"type":"string","enum":["always","never","prompt"],"enumDescriptions":["Sempre abra um repositório em pastas pai de workspaces ou arquivos abertos.","Nunca abra um repositório em pastas pai de workspaces ou arquivos abertos.","Avise antes de abrir um repositório nas pastas pai dos workspaces ou arquivos abertos."],"default":"prompt","markdownDescription":"Controle se um repositório em pastas pai de workspaces ou arquivos abertos deve ser aberto.","scope":"resource"},"git.similarityThreshold":{"type":"number","default":50,"minimum":0,"maximum":100,"markdownDescription":"Controla o limite do índice de similaridade (a quantidade de adições/exclusões em comparação com o tamanho do arquivo) para que alterações em um par de arquivos adicionados/excluídos sejam consideradas uma renomeação. **Observação:** Requer o Git versão `2.18.0` ou posterior.","scope":"resource"},"git.blame.editorDecoration.enabled":{"type":"boolean","default":false,"markdownDescription":"Controla se as informações de blame devem ser mostradas no editor usando decorações do editor."},"git.blame.editorDecoration.template":{"type":"string","default":"${subject}, ${authorName} (${authorDateAgo})","markdownDescription":"Modelo para a decoração do editor de informações de reação. Variáveis com suporte:\r\n\r\n* `hash`: hash do Commit\r\n\r\n* `hashShort`: primeiros N caracteres do hash de confirmação de acordo com `#git.commitShortHashLength#`\r\n\r\n* `subject`: Primeira linha do mensagem do commit\r\n\r\n* `authorName`: nome do autor\r\n\r\n* `authorEmail`: Email do autor\r\n\r\n* `authorDate`: data do autor\r\n\r\n* `authorDateAgo`: diferença de tempo entre agora e a data do autor\r\n\r\n"},"git.blame.editorDecoration.disableHover":{"type":"boolean","default":false,"markdownDescription":"Controla se a exibição flutuante das informações de blame nas decorações do editor deve ser desativada."},"git.blame.statusBarItem.enabled":{"type":"boolean","default":true,"markdownDescription":"Controla se as informações de blame devem ser mostradas na barra de status."},"git.blame.statusBarItem.template":{"type":"string","default":"${authorName} (${authorDateAgo})","markdownDescription":"Modelo para o item barra de status de informações de blame. Variáveis com suporte:\r\n\r\n* `hash`: hash do Commit\r\n\r\n* `hashShort`: primeiros N caracteres do hash de confirmação de acordo com `#git.commitShortHashLength#`\r\n\r\n* `subject`: Primeira linha do mensagem do commit\r\n\r\n* `authorName`: nome do autor\r\n\r\n* `authorEmail`: Email do autor\r\n\r\n* `authorDate`: data do autor\r\n\r\n* `authorDateAgo`: diferença de tempo entre agora e a data do autor\r\n\r\n"},"git.blame.ignoreWhitespace":{"type":"boolean","default":false,"markdownDescription":"Controla se as alterações de espaço em branco serão ignoradas ao calcular as informações de blame."},"git.commitShortHashLength":{"type":"number","default":7,"minimum":7,"maximum":40,"markdownDescription":"Controla o comprimento do hash curto de confirmação.","scope":"resource"},"git.diagnosticsCommitHook.enabled":{"type":"boolean","default":false,"markdownDescription":"Controla se a verificação de diagnósticos não resolvidos deve ser feita antes de confirmar.","scope":"resource"},"git.diagnosticsCommitHook.sources":{"type":"object","additionalProperties":{"type":"string","enum":["error","warning","information","hint","none"]},"default":{"*":"error"},"markdownDescription":"Controla a lista de fontes (**Item**) e a gravidade mínima (**Valor**) a serem consideradas antes da confirmação. **Observação:** Para ignorar diagnósticos de uma fonte específica, adicione a fonte à lista e defina a gravidade mínima como `none`.","scope":"resource"},"git.discardUntrackedChangesToTrash":{"type":"boolean","default":true,"markdownDescription":"Controla se o descarte de alterações não controladas move os arquivos para a Lixeira (Windows), Lixeira (macOS, Linux) em vez de excluí-los permanentemente. **Observação:** esta configuração não tem efeito quando conectada a um remoto ou ao ser executada no Linux como um pacote de ajuste."},"git.showReferenceDetails":{"type":"boolean","default":true,"markdownDescription":"Controla se os detalhes da última confirmação para referências do Git nos seletores de check-out, branch e rótulo devem ser exibidos."}}},"colors":[{"id":"gitDecoration.addedResourceForeground","description":"Cor dos recursos adicionados.","defaults":{"light":"#587c0c","dark":"#81b88b","highContrast":"#a1e3ad","highContrastLight":"#374e06"}},{"id":"gitDecoration.modifiedResourceForeground","description":"Cor do