cript\": \"javascriptreact\"}`"},"emmet.variables":{"type":"object","properties":{"lang":{"type":"string","default":"en"},"charset":{"type":"string","default":"UTF-8"}},"additionalProperties":{"type":"string"},"default":{},"markdownDescription":"Variáveis a serem usadas em snippets do Emmet."},"emmet.syntaxProfiles":{"type":"object","default":{},"markdownDescription":"Definir o perfil para a sintaxe especificada ou usar seu próprio perfil com regras específicas."},"emmet.excludeLanguages":{"type":"array","items":{"type":"string"},"default":["markdown"],"markdownDescription":"Uma matriz de linguagens na qual as abreviações Emmet não devem ser expandidas."},"emmet.extensionsPath":{"type":"array","items":{"type":"string","markdownDescription":"Um caminho que contém a sintaxe EmmetProfiles e/ou trechos."},"default":[],"scope":"machine-overridable","markdownDescription":"Uma matriz de caminhos, em que cada caminho pode conter Emmet syntaxProfiles e/ou arquivos de Snippet.\r\nNo caso de conflitos, os perfis/snippets de caminhos posteriores substituirão os caminhos anteriores.\r\nConsulte https://code.visualstudio.com/docs/editor/emmet para obter mais informações e um arquivo de snippet de exemplo."},"emmet.triggerExpansionOnTab":{"type":"boolean","default":false,"scope":"language-overridable","markdownDescription":"Quando habilitadas, as abreviações do Emmet são expandidas ao pressionar TAB, mesmo quando as conclusões não aparecem. Quando desativado, as conclusões que aparecem ainda podem ser aceitas pressionando TAB."},"emmet.useInlineCompletions":{"type":"boolean","default":false,"markdownDescription":"Se `true`, o Emmet usará conclusões embutidas para sugerir expansões. Para evitar que o provedor de item de conclusão não embutido apareça com tanta frequência enquanto essa configuração for `true`, mude `#editor.quickSuggestions#` para `inline` ou `off` para o item `other`."},"emmet.preferences":{"type":"object","default":{},"markdownDescription":"Preferências usadas para modificar o comportamento de algumas ações e resolvedores do Emmet.","properties":{"css.intUnit":{"type":"string","default":"px","markdownDescription":"Unidade padrão para valores inteiros."},"css.floatUnit":{"type":"string","default":"em","markdownDescription":"Unidade padrão para valores float."},"css.propertyEnd":{"type":"string","default":";","markdownDescription":"Símbolo a ser posicionado no final da propriedade do CSS ao expandir abreviações do CSS."},"sass.propertyEnd":{"type":"string","default":"","markdownDescription":"Símbolo a ser colocado no final da propriedade do CSS ao expandir abreviações do CSS em arquivos Sass."},"stylus.propertyEnd":{"type":"string","default":"","markdownDescription":"Símbolo a ser colocado no final da propriedade do CSS ao expandir abreviações do CSS em arquivos Stylus."},"css.valueSeparator":{"type":"string","default":": ","markdownDescription":"Símbolo a ser posicionado entre o valor e a propriedade do CSS ao expandir as abreviações do CSS."},"sass.valueSeparator":{"type":"string","default":": ","markdownDescription":"Símbolo a ser colocado entre o valor e a propriedade do CSS ao expandir abreviações do CSS em arquivos do Sass."},"stylus.valueSeparator":{"type":"string","default":" ","markdownDescription":"Símbolo a ser colocado entre o valor e a propriedade do CSS ao expandir abreviações do CSS em arquivos Stylus."},"bem.elementSeparator":{"type":"string","default":"__","markdownDescription":"Separador de elemento usado para classes ao usar o filtro BEM."},"bem.modifierSeparator":{"type":"string","default":"_","markdownDescription":"Separador modificador usado para classes ao usar o filtro BEM."},"filter.commentBefore":{"type":"string","default":"","markdownDescription":"Uma definição de comentário que deve ser posicionada antes do elemento correspondente quando o filtro de comentário é aplicado."},"filter.commentAfter":{"type":"string","default":"\n<!-- /[#ID][.CLASS] -->","markdownDescription":"Uma definição de comentário que deve ser posicionada após o elemento correspondente quando o filtro de comentário é aplicado."},"filter.commentTrigger":{"type":"array","default":["id","class"],"markdownDescription":"Uma lista de nomes de atributos separados por vírgulas que devem existir em abreviação para que o filtro de comentários seja aplicado."},"format.noIndentTags":{"type":"array","default":["html"],"markdownDescription":"Uma matriz de nomes de marcas que não deve obter recuo interno."},"format.forceIndentationForTags":{"type":"array","default":["body"],"markdownDescription":"Uma matriz de nomes de marcas que sempre deve obter recuo interno."},"profile.allowCompactBoolean":{"type":"boolean","default":false,"markdownDescription":"Quando esta opção é `true`, a notação compacta de atributos boolianos é produzida."},"css.webkitProperties":{"type":"string","default":null,"markdownDescription":"Propriedades do CSS separadas por vírgulas que recebem o prefixo de fornecedor `webkit` quando usadas na abreviação do Emmet que começa com `-`. Defina como cadeia de caracteres vazia para sempre evitar o prefixo `webkit`."},"css.mozProperties":{"type":"string","default":null,"markdownDescription":"Propriedades do CSS separadas por vírgulas que recebem o prefixo de fornecedor `moz` quando usadas na abreviação do Emmet que começa com `-`. Defina como cadeia de caracteres vazia para sempre evitar o prefixo `moz`."},"css.oProperties":{"type":"string","default":null,"markdownDescription":"Propriedades do CSS separadas por vírgulas que recebem o prefixo de fornecedor `o` quando usadas na abreviação do Emmet que começa com `-`. Defina como cadeia de caracteres vazia para sempre evitar o prefixo `o`."},"css.msProperties":{"type":"string","default":null,"markdownDescription":"Propriedades do CSS separadas por vírgulas que recebem o prefixo do fornecedor `ms` quando usadas na abreviação do Emmet que começa com `-`. Defina como cadeia de caracteres vazia para sempre evitar o prefixo `ms`."},"css.fuzzySearchMinS